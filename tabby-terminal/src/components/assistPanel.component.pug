//- State line: what the assistant is doing, read from the terminal title
.assist-state
    .state-badge([class]='"state-" + state')
        i.fas.fa-fw.fa-circle-notch.fa-spin(*ngIf='state === "working" || state === "starting"')
        i.fas.fa-fw.fa-hand(*ngIf='state === "waiting"')
        i.fas.fa-fw.fa-check(*ngIf='state === "idle"')
        i.fas.fa-fw.fa-plug-circle-xmark(*ngIf='state === "ended"')
        span.ms-1 {{stateLabel}}
        span.ms-1.elapsed(*ngIf='state === "working" || state === "waiting"') {{elapsed}}
    .task([title]='task') {{task}}

    .assist-tools
        //- Keys typed on the user's behalf, only when they press them
        ng-container(*ngIf='state === "waiting"')
            button.btn.btn-sm.btn-secondary.key(
                *ngFor='let k of answerKeys',
                (click)='sendKey(k.key)',
                [title]='"Send {key}"|translate:{key: k.label}'
            ) {{k.label}}
        button.btn.btn-sm.btn-secondary(
            *ngIf='state === "working" || state === "waiting"',
            (click)='interrupt()',
            [title]='"Sends the Esc key"|translate'
        )
            i.fas.fa-stop
            span.ms-1(translate) Stop

        div(ngbDropdown, placement='top-end', container='body')
            button.btn.btn-sm.btn-link(ngbDropdownToggle, [title]='"This session"|translate')
                i.fas.fa-clock-rotate-left
                span.ms-1(*ngIf='runs.length') {{runs.length}}
            .dropdown-menu.assist-menu(ngbDropdownMenu)
                .dropdown-header(translate) Prompts sent from this tab
                .dropdown-item-text.text-muted(*ngIf='!runs.length', translate) Nothing sent yet
                button.dropdown-item.run(*ngFor='let run of runs', (click)='reuse(run)', [title]='"Put back in the input to edit and send again"|translate')
                    .run-prompt {{run.prompt}}
                    .run-meta.text-muted
                        span {{run.sentAt | date:'shortTime'}}
                        span(*ngIf='runDuration(run)') · {{runDuration(run)}}
                        span(*ngIf='run.task') · {{run.task}}

        div(ngbDropdown, placement='top-end', container='body')
            button.btn.btn-sm.btn-link(ngbDropdownToggle, [title]='"Commands and settings"|translate')
                i.fas.fa-ellipsis
            .dropdown-menu.assist-menu(ngbDropdownMenu)
                .dropdown-header(translate) Commands
                button.dropdown-item(*ngFor='let item of commands', (click)='runCommand(item)')
                    code.me-2 {{item.command}}
                    span.text-muted {{item.label|translate}}
                .dropdown-divider
                button.dropdown-item((click)='toggleSendOnEnter()')
                    i.fas.fa-fw.me-2([class.fa-check]='sendOnEnter')
                    span(translate) Send with Enter
                button.dropdown-item((click)='toggleNotifications()')
                    i.fas.fa-fw.me-2([class.fa-check]='config.store.tsugite.assist.notify')
                    span(translate) Notify when finished or waiting

        button.btn.btn-sm.btn-link((click)='toggleCollapsed()', [title]='(collapsed ? "Show the input" : "Hide the input")|translate')
            i.fas([class.fa-chevron-up]='collapsed', [class.fa-chevron-down]='!collapsed')

//- Prompts waiting for the assistant to become ready
.assist-queue(*ngIf='queue.length && !collapsed')
    .queued(*ngFor='let prompt of queue; let i = index')
        i.fas.fa-hourglass-half.me-2
        span.queued-text.me-auto([title]='prompt') {{prompt}}
        button.btn.btn-sm.btn-link((click)='sendQueuedNow(i)', [title]='"Send now"|translate')
            i.fas.fa-paper-plane
        button.btn.btn-sm.btn-link((click)='unqueue(i)', [title]='"Take back into the input"|translate')
            i.fas.fa-xmark

//- Composer
.assist-composer(*ngIf='!collapsed')
    textarea.form-control(
        #input,
        rows='3',
        [(ngModel)]='text',
        (ngModelChange)='onInput()',
        (keydown)='onKeyDown($event)',
        [placeholder]='"Write instructions… ({hint})"|translate:{hint: sendHint}'
    )
    .assist-actions
        button.btn.btn-primary.btn-sm((click)='send()', [disabled]='!text.trim()')
            i.fas.fa-paper-plane
            span.ms-1(translate) Send

.assist-chips(*ngIf='!collapsed')
    button.btn.btn-sm.chip(*ngFor='let snippet of snippets', (click)='insertSnippet(snippet)', [title]='snippet.text') {{snippet.name}}
    button.btn.btn-sm.btn-link((click)='editSnippets()', [title]='"Edit snippets"|translate')
        i.fas.fa-pen

    .ms-auto(ngbDropdown, placement='top-end', container='body')
        button.btn.btn-sm.btn-link(ngbDropdownToggle)
            i.fas.fa-list
            span.ms-1(translate) History
        .dropdown-menu.assist-menu(ngbDropdownMenu)
            .dropdown-item-text.text-muted(*ngIf='!history.length', translate) No history yet
            button.dropdown-item.run(*ngFor='let prompt of history.slice(0, 30)', (click)='pickHistory(prompt)')
                .run-prompt {{prompt}}
